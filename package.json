{
  "name": "remora",
  "productName": "Remora",
  "version": "0.1.0",
  "description": "Your laptop, in your pocket. Pair your phone once, then see the screen, control it, open a terminal and move files from anywhere.",
  "author": "chadixearth",
  "license": "MIT",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/serve-web.js",
    "check": "node --check desktop/main.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "dev.remora.desktop",
    "productName": "Remora",
    "files": [
      "desktop/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Remora-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "chadixearth",
      "repo": "remora"
    }
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  }
}
